SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_management
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_local_postgresql_password
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=this_is_a_very_long_default_secret_key_for_local_dev_only_1234567890
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false

# Initial System Administrator (Used during first startup if no admin exists)
INITIAL_ADMIN_EMAIL=admin@knoweb.com
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
